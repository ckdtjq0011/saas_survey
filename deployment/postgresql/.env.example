# PostgreSQL Database Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Database Settings
POSTGRES_DB=saas_survey
POSTGRES_USER=survey_admin
POSTGRES_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# Port Configuration
POSTGRES_PORT=5432

# Connection String for FastAPI
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://survey_admin:CHANGE_THIS_TO_STRONG_PASSWORD@localhost:5432/saas_survey

# For SSL connection
DATABASE_URL_SSL=postgresql://survey_admin:CHANGE_THIS_TO_STRONG_PASSWORD@localhost:5432/saas_survey?sslmode=require

# Timezone
TZ=Asia/Seoul
